# Erhvervsstyrelsen system-til-system access to the CVR Elasticsearch index.
# Base64 of "user:pass" — the same credential shape ScotuingData uses.
# Gleipnir keeps its own copy deliberately: the two projects have different
# retention and egress rules, and a shared credential file would make it
# ambiguous which policy a given request was made under.
CVR_API_KEY=

# Base URL of the distribution endpoint. Indices are appended per resource.
CVR_BASE_URL=http://distribution.virk.dk

# Where content-hashed raw payloads are written. Append-only; safe to back up
# and to rebuild every downstream projection from.
RAW_STORE_PATH=./raw

# EPO Open Patent Services (OPS) v3.2. Consumer key and secret from the EPO
# Developer Portal under "My Apps". OAuth2 client credentials; the free tier is
# 4GB/week, so prefer published-data/search over whole-document retrieval.
EPO_OPS_KEY=
EPO_OPS_SECRET=
